# Create .env locally. Never commit a real token.
TELEGRAM_BOT_TOKEN=
BOT_USERNAME=example_bot
SUPPORT_LINK_1=https://t.me/example_support_one
SUPPORT_LINK_2=https://t.me/example_support_two
DEV_MODE=false
DEV_TELEGRAM_USER_IDS=
PLAN_DAILY_PRICE=1
PLAN_DAILY_DAYS=1
PLAN_DAILY_LIMIT=200
PLAN_WEEKLY_PRICE=7
PLAN_WEEKLY_DAYS=7
PLAN_WEEKLY_LIMIT=250
PLAN_MONTHLY_PRICE=25
PLAN_MONTHLY_DAYS=30
PLAN_MONTHLY_LIMIT=300
REFERRAL_RATE_PERCENT=10
# Shape-only validation profile. Bump the version when changing a rule.
VALIDATION_RULES_VERSION=phase1-v1
VALIDATION_PATTERN_GAID=[0-9a-fA-F]{8}(?:-[0-9a-fA-F]{4}){3}-[0-9a-fA-F]{12}
VALIDATION_PATTERN_IDFA=[0-9a-fA-F]{8}(?:-[0-9a-fA-F]{4}){3}-[0-9a-fA-F]{12}
VALIDATION_PATTERN_IDFV=[0-9a-fA-F]{8}(?:-[0-9a-fA-F]{4}){3}-[0-9a-fA-F]{12}
VALIDATION_PATTERN_UID=[0-9]{13}-[0-9]{7}
VALIDATION_PATTERN_SINGULAR=[0-9a-fA-F]{8}(?:-[0-9a-fA-F]{4}){3}-[0-9a-fA-F]{12}
VALIDATION_MAX_INTERVAL_MINUTES=525600
